DATABASE_URL=postgres://reliability:reliability@localhost:55432/reliability
TEST_DATABASE_URL=postgres://reliability:reliability@localhost:55432/reliability_test
DEMO_MODE=true
# Set DEMO_MODE=false and fill every GitHub field to enable integration.
APP_URL=http://localhost:3000
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional server-only GitHub token for Fieldnote Skills release rate capacity.
FIELDNOTE_SKILLS_GITHUB_TOKEN=

# Optional workspace invitation delivery; configure both to enable invitations.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# RESEND_FROM_EMAIL must use a sender domain verified in Resend.
# Production: HTTPS APP_URL, INNGEST_DEV=0, and configured Inngest keys.
# Invitations remain unavailable until both Resend settings are present.

# Code graders run in E2B (https://e2b.dev). Without a key, development and
# tests use a local sandbox, and production refuses to run code graders.
E2B_API_KEY=

# Setup profile authoring also requires Anthropic. No workspace credentials
# enter the sandbox. Missing keys select the deterministic local author in dev.
ANTHROPIC_API_KEY=
FIELDNOTE_AUTHORING_MODEL=claude-sonnet-4-6
